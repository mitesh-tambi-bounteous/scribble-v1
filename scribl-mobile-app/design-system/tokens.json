{
  "color-bg": {
    "$type": "color",
    "$description": "Primary app background, used for full-screen surfaces and default component backgrounds.",
    "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }
  },
  "color-bg-subtle": {
    "$type": "color",
    "$description": "Recessed surface background for cards, chips, and grouped content.",
    "$value": { "colorSpace": "srgb", "components": [0.957, 0.957, 0.961], "hex": "#f4f4f5" }
  },
  "color-fg": {
    "$type": "color",
    "$description": "Primary text and icon color on color-bg. Meets WCAG AA (4.5:1) on color-bg.",
    "$value": { "colorSpace": "srgb", "components": [0.094, 0.094, 0.106], "hex": "#18181b" }
  },
  "color-fg-muted": {
    "$type": "color",
    "$description": "Secondary text, timestamps, helper copy.",
    "$value": { "colorSpace": "srgb", "components": [0.443, 0.443, 0.478], "hex": "#71717a" }
  },
  "color-primary": {
    "$type": "color",
    "$description": "Brand accent used for primary actions and highlights.",
    "$value": { "colorSpace": "srgb", "components": [0.145, 0.388, 0.922], "hex": "#2563eb" }
  },
  "color-primary-hover": {
    "$type": "color",
    "$description": "Hover/active state for primary-colored surfaces.",
    "$value": { "colorSpace": "srgb", "components": [0.114, 0.306, 0.847], "hex": "#1d4ed8" }
  },
  "color-on-primary": {
    "$type": "color",
    "$description": "Text/icon color placed on top of color-primary.",
    "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "hex": "#ffffff" }
  },
  "color-border": {
    "$type": "color",
    "$description": "Hairline border for cards, inputs, and dividers.",
    "$value": { "colorSpace": "srgb", "components": [0.894, 0.894, 0.906], "hex": "#e4e4e7" }
  },
  "color-shadow": {
    "$type": "color",
    "$description": "Base color for soft elevation shadows.",
    "$value": { "colorSpace": "srgb", "components": [0.831, 0.831, 0.847], "hex": "#d4d4d8" }
  },
  "space-1": {
    "$type": "dimension",
    "$description": "Smallest spacing unit: tight gaps, icon padding.",
    "$value": { "value": 4, "unit": "px" }
  },
  "space-2": {
    "$type": "dimension",
    "$description": "Compact spacing: control padding, small gaps.",
    "$value": { "value": 8, "unit": "px" }
  },
  "space-3": {
    "$type": "dimension",
    "$description": "Default spacing: component padding, stack gaps.",
    "$value": { "value": 16, "unit": "px" }
  },
  "space-4": {
    "$type": "dimension",
    "$description": "Roomy spacing: card padding, section gaps.",
    "$value": { "value": 24, "unit": "px" }
  },
  "space-5": {
    "$type": "dimension",
    "$description": "Section spacing: gaps between grouped content blocks.",
    "$value": { "value": 32, "unit": "px" }
  },
  "space-6": {
    "$type": "dimension",
    "$description": "Page-level spacing: top-level layout gutters.",
    "$value": { "value": 48, "unit": "px" }
  },
  "radius-sm": {
    "$type": "dimension",
    "$description": "Subtle rounding for inputs and small controls.",
    "$value": { "value": 6, "unit": "px" }
  },
  "radius-md": {
    "$type": "dimension",
    "$description": "Standard rounding for buttons and controls.",
    "$value": { "value": 12, "unit": "px" }
  },
  "radius-lg": {
    "$type": "dimension",
    "$description": "Generous rounding for cards and modals.",
    "$value": { "value": 20, "unit": "px" }
  },
  "radius-full": {
    "$type": "dimension",
    "$description": "Pill rounding for chips and tags.",
    "$value": { "value": 999, "unit": "px" }
  },
  "border-width-thin": {
    "$type": "dimension",
    "$description": "Hairline border thickness.",
    "$value": { "value": 1, "unit": "px" }
  },
  "font-size-sm": {
    "$type": "dimension",
    "$description": "Small text: captions, chip labels, metadata.",
    "$value": { "value": 14, "unit": "px" }
  },
  "font-size-md": {
    "$type": "dimension",
    "$description": "Body copy default size.",
    "$value": { "value": 16, "unit": "px" }
  },
  "font-size-lg": {
    "$type": "dimension",
    "$description": "Emphasized copy, card titles.",
    "$value": { "value": 20, "unit": "px" }
  },
  "font-size-xl": {
    "$type": "dimension",
    "$description": "Page and section headings.",
    "$value": { "value": 28, "unit": "px" }
  },
  "layout-container-max-width": {
    "$type": "dimension",
    "$description": "Max width for centered page containers (e.g. the style guide itself).",
    "$value": { "value": 1120, "unit": "px" }
  },
  "layout-swatch-min-width": {
    "$type": "dimension",
    "$description": "Minimum tile width for auto-filling swatch/sample grids.",
    "$value": { "value": 160, "unit": "px" }
  },
  "font-family-sans": {
    "$type": "fontFamily",
    "$description": "Primary UI typeface: clean, modern, highly legible at small sizes.",
    "$value": "'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif"
  },
  "font-weight-regular": {
    "$type": "fontWeight",
    "$value": 400
  },
  "font-weight-medium": {
    "$type": "fontWeight",
    "$value": 500
  },
  "font-weight-bold": {
    "$type": "fontWeight",
    "$value": 700
  },
  "line-height-tight": {
    "$type": "number",
    "$description": "Line height for headings.",
    "$value": 1.2
  },
  "line-height-normal": {
    "$type": "number",
    "$description": "Line height for body copy.",
    "$value": 1.5
  },
  "shadow-sm": {
    "$type": "shadow",
    "$description": "Soft elevation for cards.",
    "$value": {
      "color": "{color-shadow}",
      "offsetX": { "value": 0, "unit": "px" },
      "offsetY": { "value": 4, "unit": "px" },
      "blur": { "value": 12, "unit": "px" },
      "spread": { "value": 0, "unit": "px" }
    }
  },
  "border-hairline": {
    "$type": "border",
    "$description": "Standard 1px hairline border used across cards, chips, and inputs.",
    "$value": {
      "color": "{color-border}",
      "width": "{border-width-thin}",
      "style": "solid"
    }
  },
  "button-primary-background": {
    "$type": "color",
    "$description": "Primary button fill.",
    "$value": "{color-primary}"
  },
  "button-primary-color": {
    "$type": "color",
    "$description": "Primary button text/icon color.",
    "$value": "{color-on-primary}"
  },
  "button-primary-radius": {
    "$type": "dimension",
    "$description": "Primary button corner radius.",
    "$value": "{radius-md}"
  },
  "button-secondary-background": {
    "$type": "color",
    "$description": "Secondary (outline) button fill.",
    "$value": "{color-bg}"
  },
  "button-secondary-color": {
    "$type": "color",
    "$description": "Secondary button text/icon color.",
    "$value": "{color-fg}"
  },
  "button-secondary-border": {
    "$type": "border",
    "$description": "Secondary button border.",
    "$value": "{border-hairline}"
  },
  "button-secondary-radius": {
    "$type": "dimension",
    "$description": "Secondary button corner radius.",
    "$value": "{radius-md}"
  },
  "card-default-background": {
    "$type": "color",
    "$description": "Card surface fill.",
    "$value": "{color-bg-subtle}"
  },
  "card-default-border": {
    "$type": "border",
    "$description": "Card border.",
    "$value": "{border-hairline}"
  },
  "card-default-radius": {
    "$type": "dimension",
    "$description": "Card corner radius.",
    "$value": "{radius-lg}"
  },
  "card-default-shadow": {
    "$type": "shadow",
    "$description": "Card elevation.",
    "$value": "{shadow-sm}"
  },
  "chip-default-background": {
    "$type": "color",
    "$description": "Chip fill.",
    "$value": "{color-bg-subtle}"
  },
  "chip-default-color": {
    "$type": "color",
    "$description": "Chip text color.",
    "$value": "{color-fg}"
  },
  "chip-default-border": {
    "$type": "border",
    "$description": "Chip border.",
    "$value": "{border-hairline}"
  },
  "chip-default-radius": {
    "$type": "dimension",
    "$description": "Chip corner radius (pill).",
    "$value": "{radius-full}"
  },
  "input-default-background": {
    "$type": "color",
    "$description": "Form control fill.",
    "$value": "{color-bg}"
  },
  "input-default-border": {
    "$type": "border",
    "$description": "Form control border.",
    "$value": "{border-hairline}"
  },
  "input-default-radius": {
    "$type": "dimension",
    "$description": "Form control corner radius.",
    "$value": "{radius-sm}"
  },
  "input-default-color": {
    "$type": "color",
    "$description": "Form control text color.",
    "$value": "{color-fg}"
  }
}
